#include <stdio.h>



// Criar duas funções, uma para Área e outra para Perímetro
double calcularArea(double a, double b) {
    //double Area = a * b;
    return a * b;
}

double calcularPerimetro(double a, double b) {
    double Soma = a + b;
    return Soma * 2.0;
}

